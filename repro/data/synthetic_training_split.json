{
  "schema_version": 1,
  "selection": {
    "glob": "*_label.nii.gz",
    "ordering": "lexicographic",
    "max_volumes": 500,
    "selected_ids": "vol0000 through vol0499"
  },
  "split": {
    "validation_fraction": 0.2,
    "validation_ids": "vol0000 through vol0099",
    "training_ids": "vol0100 through vol0499",
    "validation_volumes": 100,
    "training_volumes": 400
  },
  "sampling": {
    "samples_per_volume": 2,
    "validation_samples": 200,
    "training_samples_per_cache": 800,
    "cache_reuse_epochs": 3
  },
  "dense_generation": {
    "shape": [128, 128, 128],
    "voxel_size_mm": 0.0008,
    "seed_formula": "42000 + volume_id",
    "density_exponent_range": [6.1, 6.6]
  },
  "limitation": "The original dense corpus was generated before a file-hash manifest was recorded."
}
