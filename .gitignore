# Python and tooling caches
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.coverage
htmlcov/
.ipynb_checkpoints/
build/
dist/

# Local environments and configuration
.venv/
venv/
.env
.env.*
*.local.env
/config/site.env
/config/*.local.*
!config/site.example.env

# Checkpoint weights are distributed locally, never through Git
*.pt
*.pth
*.ckpt
*.safetensors

# Generated outputs and scheduler logs
output/
outputs/
artifacts/
logs/
logs_*/
slurm_logs/
**/tensorboard/
events.out.tfevents.*
slurm-*.out
slurm-*.err
*.slurm.out
*.slurm.err

# Volumetric, array, and raw data
*.nii
*.nii.gz
*.npy
*.npz
*.raw
*.memmap
*.mmap
*.zarr
*.zarr/
*.h5
*.hdf5
*.lsm
*.tif
*.tiff
raw/

# Results are generated by default; retain only curated tabular metadata
/results/**
!/results/**/
!/results/**/*.csv
!/results/**/*.json
/repro/data/**
!/repro/data/**/
!/repro/data/**/*.csv
!/repro/data/**/*.json
!repro/**/*.csv
!repro/**/*.json
!config/**/*.csv
!config/**/*.json

# Editor and OS files
.DS_Store
.idea/
.vscode/
*~
/tmp/
