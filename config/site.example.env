# Local paths. Keep the populated config/site.env out of Git.
export PROJECT_DIR=/path/to/axonsynth-release
export DATA_ROOT=/path/to/lsm_12patch_data
export OUTPUT_ROOT=/path/to/axonsynth_outputs
export DENSE_LABEL_ROOT=/path/to/synthetic_labels
export LABEL_DIR=${DENSE_LABEL_ROOT}/train
export CHECKPOINT_ROOT=/path/to/local_checkpoints
export PYTHON=/path/to/axonsynth/bin/python

export THREE_CLASS_CHECKPOINT=${CHECKPOINT_ROOT}/three_class_v2_best_model.pt
export BINARY_CHECKPOINT=${CHECKPOINT_ROOT}/binary_best_model_ep200.pt
